{
  "schema_version": "edu.fusion-record.v1",
  "readiness": "usable",
  "workload": {
    "purpose": "教师中英双语 Web 科学活动设计",
    "trigger": "Create/revise teacher science activities with judgment before evidence",
    "exclusions": [
      "general tutoring",
      "other subject planning",
      "model training",
      "deployment"
    ],
    "inputs": [
      "grade/time/question",
      "teacher supplied data or readable texts",
      "Web constraints"
    ],
    "outputs": [
      "bilingual teacher activity",
      "<=2 candidate table",
      "learner flow/data contract/acceptance",
      "fusion record and walkthroughs"
    ],
    "constraints": [
      {
        "id": "R1",
        "level": "hard",
        "requirement": "为教师科学活动设计创建独立 skill，触发范围只限该重复工作。"
      },
      {
        "id": "R2",
        "level": "hard",
        "requirement": "交付教师与学生可用的中英双语内容；Web 是目标平台。"
      },
      {
        "id": "R3",
        "level": "hard",
        "requirement": "每次最多两个候选；没有可读来源时可交付零候选和缺口，不能凑十个。"
      },
      {
        "id": "R4",
        "level": "hard",
        "requirement": "学生先写出判断并提交，再看证据；答案和证据均不得提前泄露。"
      },
      {
        "id": "R5",
        "level": "hard",
        "requirement": "初版不得依赖付费模型；使用教师预编写材料和静态规则。"
      },
      {
        "id": "R6",
        "level": "hard",
        "requirement": "PDF 工具目前不可用：不能声称提取、页码覆盖或要求该工具作为依赖。"
      },
      {
        "id": "R7",
        "level": "hard",
        "requirement": "premium-planner 仅是目录线索；不复制或推断未读实现。"
      },
      {
        "id": "R8",
        "level": "hard",
        "requirement": "不得强制数学分层提示，也不得并入所有来源触发词。"
      },
      {
        "id": "R9",
        "level": "hard",
        "requirement": "原始来源保持不变，记录身份、许可、方法取舍、目标与维护映射。"
      },
      {
        "id": "R10",
        "level": "hard",
        "requirement": "交付新 skill、可维护的 fusion-record.json、至少两个任务走查并运行包内 helper。"
      }
    ],
    "precedence": [
      "explicit user hard requirements",
      "tool/platform constraints",
      "optional teacher preferences",
      "source defaults"
    ]
  },
