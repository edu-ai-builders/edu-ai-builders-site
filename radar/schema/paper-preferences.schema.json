{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local paper digest preferences",
  "type": "object",
  "required": [
    "user_id",
    "enabled",
    "frequency",
    "interests"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "frequency": {
      "enum": [
        "daily",
        "weekly",
        "manual",
        "disabled"
      ]
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "delivery_channel": {
      "const": "local-file"
    }
  }
}
